# route-arena runs fully offline in MOCK MODE by default — no keys required.
#
# To route the matching models to LIVE provider APIs instead, copy this file
# to `.env`, fill in real keys, and export them into your shell (route-arena
# reads them from the environment). NEVER commit your real `.env`.
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# OpenAI models (gpt-4o, gpt-4o-mini) go live when this is set:
OPENAI_API_KEY=

# Anthropic models (claude-sonnet, claude-haiku) go live when this is set:
ANTHROPIC_API_KEY=

# llama-3-70b has no first-party key path here and is always served via mock.
